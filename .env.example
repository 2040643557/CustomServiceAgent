# OpenAI 兼容 API Key（必填）
OPENAI_API_KEY=sk-xxx

# API 地址（默认 OpenAI 官方；使用中转或兼容服务时替换）
OPENAI_BASE_URL=https://api.openai.com/v1

# 对话模型
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.7

# 部分兼容服务（如 DeepSeek）可通过该参数关闭思考模式；
# OpenAI 官方接口请保持 false。
LLM_DISABLE_THINKING=false

# ReAct 最大工具调用轮数
MAX_REACT_STEPS=5

# 多轮对话管理
SESSION_PATH=app/sessions/session.json
HISTORY_THRESHOLD=10
HISTORY_KEEP_RECENT=3

# MCP 配置，启用前先运行 python mcp_server/server.py
MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9123/mcp

# Multi-Agent 配置
MULTI_AGENT_ENABLED=false

# Memory 配置
MEMORY_ENABLED=true
MEMORY_DIR=app/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50

# Skill 配置
SKILLS_ENABLED=true
SKILLS_DIR=app/agent/skills/definitions

# Evaluation 配置（离线评估工具）
EVAL_DATASET_PATH=app/evaluation/cases.json
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6

# RAG 配置：使用本地 SentenceTransformer 模型
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 国内下载模型较慢时，可取消注释使用镜像
# HF_ENDPOINT=https://hf-mirror.com
KB_DIR=app/agent/rag/knowledge
# 向量后端：numpy（零依赖，默认）/ chroma（需要 chromadb）
RAG_BACKEND=numpy
# NumpyBackend 索引文件
KB_INDEX_PATH=app/sessions/kb_index.json
# ChromaBackend 持久化目录 + collection
CHROMA_PERSIST_DIR=app/sessions/chroma
CHROMA_COLLECTION=ecom_kb
